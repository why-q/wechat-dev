# Fill all six values, then run `uv run --locked python -m rag_poc.cli check-config` for local format validation.
# Add `--live` only when you intend to send fixed synthetic probes to both remote APIs.
# OpenAI-compatible chat API
RAG_LLM_API_BASE=https://chat-provider.example/v1
RAG_LLM_API_KEY=replace-with-chat-api-key
RAG_LLM_MODEL=chat-model-name

# OpenAI-compatible embeddings API (may be a different provider)
RAG_EMBEDDING_API_BASE=https://embedding-provider.example/v1
RAG_EMBEDDING_API_KEY=replace-with-embedding-api-key
RAG_EMBEDDING_MODEL=embedding-model-name
