# Self-hosted relay + support backend configuration (/etc/wechat-relay.env, mode 0600).
# Cloud Hosting itself only needs WECHAT_FORWARD_URL and WECHAT_FORWARD_TOKEN.

# --- Shared relay authentication & optional Cloud Hosting origin check ---
RELAY_AUTH_TOKEN=replace-with-shared-bearer-token
# WECHAT_CLOUD_EXPECTED_SOURCE=other
# WECHAT_CLOUD_EXPECTED_ENV=your-cloud-env-id
# WECHAT_CLOUD_EXPECTED_APPID=your-official-account-appid

# --- WeChat Official Account direct reply credentials (customer service API) ---
WECHAT_APP_ID=replace-with-wechat-appid
WECHAT_APP_SECRET=replace-with-wechat-appsecret

# --- Tier 1b decision-model-preview endpoint ---
SUPPORT_DECISION_BASE_URL=https://your-llm-gateway/v1
SUPPORT_DECISION_API_KEY=replace-with-decision-api-key
# SUPPORT_DECISION_MODEL=decision-model-preview
# SUPPORT_DECISION_TIMEOUT_SECONDS=3.0

# --- Tier 2 RAG LLM & Embedding endpoints ---
RAG_LLM_API_BASE=https://your-llm-gateway/v1
RAG_LLM_API_KEY=replace-with-rag-llm-api-key
RAG_LLM_MODEL=deepseek-chat
RAG_EMBEDDING_API_BASE=https://your-embedding-gateway/v1
RAG_EMBEDDING_API_KEY=replace-with-embedding-api-key
RAG_EMBEDDING_MODEL=text-embedding-v3

# --- Auto-reply rollout & pipeline tuning ---
SUPPORT_AUTO_REPLY_ENABLED=true
# SUPPORT_AUTO_REPLY_ALLOWLIST=openid1,openid2
# SUPPORT_GRAY_ENROLL_KEYWORD=replace-with-gray-enroll-keyword
SUPPORT_MERGE_ENABLED=false
SUPPORT_IMMEDIATE_MAX_PREEMPTS=2

# --- HTTPS staff dashboard (disabled for each role while its password is unset) ---
# Use unique long passwords; uncomment and replace placeholders before enabling access.
# SUPPORT_DASHBOARD_ADMIN_PASSWORD=replace-with-long-random-admin-password
# SUPPORT_DASHBOARD_LIBRARIAN_PASSWORD=replace-with-long-random-librarian-password
SUPPORT_DASHBOARD_PUBLIC_ORIGIN=https://wechat-dev.llink.cyou
